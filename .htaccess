# ============================================================
# .htaccess RAÍZ — Bloquea todo acceso fuera de /app/
# ============================================================

# 1. Desactivar listado de directorios
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 2. Bloquear dotfiles en cualquier nivel (.env, .git, .htaccess expuesto, etc.)
    RewriteRule (^|\/)\. - [F,L]

    # 3. Permitir explícitamente todo lo que empiece con /app/
    RewriteCond %{REQUEST_URI} ^/app/ [NC]
    RewriteRule ^ - [L]

    # 4. Bloquear TODO lo demás → 403 Forbidden
    RewriteRule ^ - [F,L]
</IfModule>

# 5. Cabeceras de seguridad adicionales
<IfModule mod_headers.c>
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
